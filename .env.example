# ════════════════════════════════════════════════════════════════════════════
# ScuoleLive — Configurazione ambiente
# ════════════════════════════════════════════════════════════════════════════
# Copia questo file in .env e compila TUTTI i valori prima del deploy.
# NON committare il file .env nel repository.
# Dopo ogni modifica al .env in produzione: php artisan config:clear
# ════════════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="ScuoleLive"
# PRODUZIONE: production | SVILUPPO: local
APP_ENV=production
APP_KEY=
# ⚠️  PRODUZIONE: SEMPRE false — esporre stack trace è un rischio di sicurezza
APP_DEBUG=false
# URL pubblico dell'app (senza trailing slash)
APP_URL=https://tuodominio.it

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT
APP_TIMEZONE=Europe/Rome

APP_MAINTENANCE_DRIVER=file

# Aumenta il numero di rounds per password più sicure (default 12 va bene)
BCRYPT_ROUNDS=12

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
# PRODUZIONE: error | SVILUPPO: debug
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null
# Quanti giorni di log mantenere (driver "daily")
LOG_DAILY_DAYS=14

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# PRODUZIONE cPanel: aealingue_scuole
DB_DATABASE=aealingue_scuole
DB_USERNAME=
DB_PASSWORD=
# Charset utf8mb4 obbligatorio per emoji e caratteri speciali
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ── Sessione ──────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
# ⚠️  PRODUZIONE: true — cookie sessione cifrato lato server
SESSION_ENCRYPT=true
# ⚠️  PRODUZIONE: true — cookie inviato solo via HTTPS
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
# Vuoto = current host. Per sotto-domini multi-app: .tuodominio.it
SESSION_DOMAIN=

# ── Cache & Queue ─────────────────────────────────────────────────────────────
# database = persistente, file = veloce ma non condivisibile, redis = ottimale
CACHE_STORE=database
CACHE_PREFIX=scuolelive_

# Code asincrone: database (default), redis, sqs
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Mail (SMTP reale in produzione) ───────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# tls (porta 587 STARTTLS) o ssl (porta 465)
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ── Stripe (live) ─────────────────────────────────────────────────────────────
# Chiavi: https://dashboard.stripe.com/apikeys
STRIPE_KEY=pk_live_...
STRIPE_SECRET=sk_live_...
# Webhook secret: copiarlo dopo aver creato il webhook su /webhook/stripe
# Eventi: checkout.session.completed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=whsec_...

# ── PayPal (live) ─────────────────────────────────────────────────────────────
# App: https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Live: https://api-m.paypal.com  |  Sandbox: https://api-m.sandbox.paypal.com
PAYPAL_BASE_URL=https://api-m.paypal.com
# ⚠️  In production, se vuoto, il webhook /webhook/paypal viene BLOCCATO per sicurezza.
# Copia il Webhook ID dopo aver creato l'endpoint su PayPal.
# Evento richiesto: PAYMENT.CAPTURE.COMPLETED
PAYPAL_WEBHOOK_ID=

# ── Bonifico bancario ─────────────────────────────────────────────────────────
# Questi valori sono fallback. La fonte primaria è SchoolSetting (admin pannello).
BANK_IBAN=
BANK_INTESTATARIO=

# ── Google Calendar / Meet ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT=https://tuodominio.it/google/callback
# ID del calendario condiviso col service account
GOOGLE_CALENDAR_ID=
# Path al JSON del service account (relativo a base_path)
GOOGLE_SERVICE_ACCOUNT_JSON=storage/app/google/service-account.json

# ── Sentry — monitoraggio errori produzione ──────────────────────────────────
# DSN: https://sentry.io/settings/<org>/projects/<project>/keys/
SENTRY_LARAVEL_DSN=
# Sample rate per il performance monitoring (0.0 - 1.0). 0.1 = 10% delle richieste.
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0
# Opzionale: invio breadcrumb console
SENTRY_SEND_DEFAULT_PII=false

# ── Backup (spatie/laravel-backup) ────────────────────────────────────────────
# Email a cui arrivano notifiche backup (success / failure / vecchio backup)
BACKUP_NOTIFICATION_EMAIL=
# Password per cifrare l'archivio .zip (opzionale, raccomandato in produzione)
BACKUP_ARCHIVE_PASSWORD=
# Nome cartella dei backup in storage (default: APP_NAME)
BACKUP_NAME="${APP_NAME}"

# ── Vite (frontend) ───────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ── Filament ──────────────────────────────────────────────────────────────────
# Path base dei pannelli (di default /superadmin, /admin, /docente, /studente)
# Modificarli SOLO se serve white-labeling
# FILAMENT_FILESYSTEM_DISK=public

# ── SEO / Analytics ───────────────────────────────────────────────────────────
# Tutti opzionali. Lasciare vuoto per non caricare lo script.
# Dopo modifica:  php artisan config:clear

# Google Analytics 4 (es. G-XXXXXXXXXX) — alternativa a GTM
SEO_GA4_ID=

# Google Tag Manager (es. GTM-XXXXXXX) — alternativa/aggiunta a GA4
SEO_GTM_ID=

# Search Console verification meta-tag (solo il valore, non l'intero meta)
SEO_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster verification
SEO_BING_SITE_VERIFICATION=

# Meta (Facebook) Pixel
SEO_FACEBOOK_PIXEL_ID=

# Meta Business — verifica dominio
SEO_FACEBOOK_DOMAIN_VERIFICATION=

# ════════════════════════════════════════════════════════════════════════════
# CHECKLIST POST-COPIA in .env di produzione:
#  1. php artisan key:generate          → genera APP_KEY
#  2. Compilare DB_USERNAME / DB_PASSWORD
#  3. Compilare MAIL_* con un SMTP reale (no Gmail per invii massivi)
#  4. Compilare STRIPE_KEY / SECRET / WEBHOOK_SECRET (live)
#  5. Compilare PAYPAL_CLIENT_ID / SECRET / WEBHOOK_ID (live)
#  6. Compilare GOOGLE_CALENDAR_ID + caricare service-account JSON
#  7. Compilare SENTRY_LARAVEL_DSN
#  8. Compilare BACKUP_NOTIFICATION_EMAIL
#  9. Compilare IBAN scuola in Admin → Impostazioni Scuola (NON nel .env)
# 10. SPF / DKIM / DMARC sul dominio MAIL_FROM_ADDRESS
# 11. Configurare cron schedule:run + queue:work in cPanel
# ════════════════════════════════════════════════════════════════════════════
